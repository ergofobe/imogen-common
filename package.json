{
  "name": "@imogen/shared",
  "version": "0.5.1",
  "type": "module",
  "description": "The imogen API contract: zod schemas and types shared by the server and every client",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ergofobe/imogen-common"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "keywords": [
    "imogen",
    "photos",
    "api-contract",
    "zod"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepack": "bun run build --force",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "npm-publish": "npm publish --access public"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.9.2"
  }
}
